# Copy this file to .env. Never commit the populated .env file.
# OpenAI is the recommended/default provider for this assignment.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EVAL_CHAT_MODEL=gpt-4o-mini
OPENAI_EVAL_EMBEDDING_MODEL=text-embedding-3-small
RAGAS_MAX_WORKERS=0

# Optional Gemini alternative through Google's OpenAI-compatible endpoint.
# If used, change LLM_PROVIDER above to gemini and leave OPENAI_API_KEY blank.
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# A separate model keeps evaluation quota independent from enrichment/generation.
GEMINI_EVAL_CHAT_MODEL=gemini-3.1-flash-lite
GEMINI_EVAL_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_RAGAS_RPM=12
GEMINI_ENRICH_RPM=12
